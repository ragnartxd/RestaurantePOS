# Copy this file to ".env" (next to main.py) and fill in your own values.
# The real .env is ignored by git and must NEVER be committed.

# Waitstaff web app (phone)
PIN_ACCESO=1234

# Owner's remote dashboard
DASHBOARD_PASSWORD=change_this_password

# Security cameras (HiLook/Hikvision NVR)
NVR_IP=192.168.1.2
NVR_USUARIO=admin
NVR_PASSWORD=change_this_password

# Password that unlocks the Cameras tab in the desktop app
CAMERAS_PASSWORD=change_this_password

# Supervisor password required to delete an expense
SUPERVISOR_PASSWORD=change_this_password

# Secret used to derive per-machine activation keys
# (must match the private key-generator script, which is not in this repo)
LICENSE_SECRET=replace_with_a_long_random_string
